# ============================================
# Security / Punto 9 - Documentación y Scripts
# ============================================
# Permitir documentación de seguridad
!docs/
!docs/**

# Permitir scripts de seguridad (NO los certificados generados)
!scripts/generate-selfsigned-cert.sh
!scripts/generate-selfsigned-cert.ps1
!scripts/setup-firewall.sh
!scripts/setup-firewall.ps1

# ============================================
# Archivos de configuración sensibles
# ============================================
# No subir configuraciones con datos reales
**/config.js
**/secrets.json
**/credentials.json
**/*secret*
**/*password*
**/*token*

# ============================================
# Archivos de evidencia con información sensible
# ============================================
evidencia_*.txt
evidencia_*.log
*_token*.txt
*_password*.txt
*_secret*.txt

