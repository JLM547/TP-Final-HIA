{
  "dashboard": {
    "title": "Sistema - Métricas Generales (cAdvisor)",
    "tags": ["sistema", "docker", "cadvisor"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage por Contenedor (%)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\"tienda-.*|mongo.*|mongodb.*\"}[5m]) * 100",
            "legendFormat": "{{name}}"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "max": 100
          }
        ]
      },
      {
        "id": 2,
        "title": "Memoria Usage por Contenedor (MB)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\"tienda-.*|mongo.*|mongodb.*\"} / 1024 / 1024",
            "legendFormat": "{{name}}"
          }
        ],
        "yaxes": [
          {
            "format": "mbytes"
          }
        ]
      },
      {
        "id": 3,
        "title": "Network I/O por Contenedor",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\"tienda-.*|mongo.*|mongodb.*\"}[5m])",
            "legendFormat": "{{name}} - RX"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{name=~\"tienda-.*|mongo.*|mongodb.*\"}[5m])",
            "legendFormat": "{{name}} - TX"
          }
        ],
        "yaxes": [
          {
            "format": "Bps"
          }
        ]
      },
      {
        "id": 4,
        "title": "Estado de Servicios",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "up{job=\"prometheus\"}",
            "legendFormat": "Prometheus"
          },
          {
            "expr": "up{job=\"backend\"}",
            "legendFormat": "Backend"
          },
          {
            "expr": "up{job=\"mongodb-node1\"}",
            "legendFormat": "MongoDB Node 1"
          },
          {
            "expr": "up{job=\"mongodb-node2\"}",
            "legendFormat": "MongoDB Node 2"
          },
          {
            "expr": "up{job=\"mongodb-node3\"}",
            "legendFormat": "MongoDB Node 3"
          },
          {
            "expr": "up{job=\"cadvisor\"}",
            "legendFormat": "cAdvisor"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "I/O de Disco por Contenedor",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(container_fs_reads_bytes_total{name=~\"tienda-.*|mongo.*|mongodb.*\"}[5m])",
            "legendFormat": "{{name}} - Lectura"
          },
          {
            "expr": "rate(container_fs_writes_bytes_total{name=~\"tienda-.*|mongo.*|mongodb.*\"}[5m])",
            "legendFormat": "{{name}} - Escritura"
          }
        ],
        "yaxes": [
          {
            "format": "Bps"
          }
        ]
      },
      {
        "id": 6,
        "title": "Uso de Memoria Detallado",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\"tienda-.*|mongo.*|mongodb.*\"} / 1024 / 1024",
            "legendFormat": "{{name}} - Total"
          },
          {
            "expr": "container_memory_rss{name=~\"tienda-.*|mongo.*|mongodb.*\"} / 1024 / 1024",
            "legendFormat": "{{name}} - RSS"
          },
          {
            "expr": "container_memory_cache{name=~\"tienda-.*|mongo.*|mongodb.*\"} / 1024 / 1024",
            "legendFormat": "{{name}} - Cache"
          }
        ],
        "yaxes": [
          {
            "format": "mbytes"
          }
        ]
      },
      {
        "id": 7,
        "title": "Resumen de Contenedores MongoDB",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "container_cpu_usage_seconds_total{name=~\"mongo.*|mongodb.*\"}",
            "format": "table",
            "legendFormat": "CPU"
          },
          {
            "expr": "container_memory_usage_bytes{name=~\"mongo.*|mongodb.*\"} / 1024 / 1024",
            "format": "table",
            "legendFormat": "Memoria (MB)"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {
                "Time": 0,
                "Value": 1,
                "name": 2
              },
              "renameByName": {
                "Value": "Valor",
                "name": "Contenedor"
              }
            }
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 2,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
