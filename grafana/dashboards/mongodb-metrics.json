{
  "dashboard": {
    "title": "MongoDB - Métricas de Base de Datos (Replica Set)",
    "tags": ["mongodb", "database", "replica-set"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Operaciones por Segundo por Nodo",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(mongodb_opcounters_insert_total[5m])",
            "legendFormat": "{{instance}} - Inserciones"
          },
          {
            "expr": "rate(mongodb_opcounters_query_total[5m])",
            "legendFormat": "{{instance}} - Consultas"
          },
          {
            "expr": "rate(mongodb_opcounters_update_total[5m])",
            "legendFormat": "{{instance}} - Actualizaciones"
          },
          {
            "expr": "rate(mongodb_opcounters_delete_total[5m])",
            "legendFormat": "{{instance}} - Eliminaciones"
          }
        ],
        "yaxes": [
          {
            "format": "ops"
          }
        ]
      },
      {
        "id": 2,
        "title": "Conexiones Activas por Nodo",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "mongodb_connections{state=\"current\"}",
            "legendFormat": "{{instance}} - Conexiones Actuales"
          },
          {
            "expr": "mongodb_connections{state=\"available\"}",
            "legendFormat": "{{instance}} - Conexiones Disponibles"
          }
        ],
        "yaxes": [
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Estado del Replica Set",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "mongodb_replset_member_health",
            "legendFormat": "{{instance}} - {{state}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Tamaño de Base de Datos por Nodo (MB)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "mongodb_dbstats_dataSize_bytes{instance=~\"mongo1|mongo2|mongo3\"} / 1024 / 1024",
            "legendFormat": "{{instance}} - Tamaño de Datos"
          },
          {
            "expr": "mongodb_dbstats_storageSize_bytes{instance=~\"mongo1|mongo2|mongo3\"} / 1024 / 1024",
            "legendFormat": "{{instance}} - Tamaño de Almacenamiento"
          }
        ],
        "yaxes": [
          {
            "format": "mbytes"
          }
        ]
      },
      {
        "id": 5,
        "title": "Latencia de Operaciones por Nodo",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "mongodb_operation_latencies_latency{operation=\"command\"}",
            "legendFormat": "{{instance}} - Comandos"
          },
          {
            "expr": "mongodb_operation_latencies_latency{operation=\"query\"}",
            "legendFormat": "{{instance}} - Consultas"
          },
          {
            "expr": "mongodb_operation_latencies_latency{operation=\"insert\"}",
            "legendFormat": "{{instance}} - Inserciones"
          },
          {
            "expr": "mongodb_operation_latencies_latency{operation=\"update\"}",
            "legendFormat": "{{instance}} - Actualizaciones"
          }
        ],
        "yaxes": [
          {
            "format": "s"
          }
        ]
      },
      {
        "id": 6,
        "title": "Operaciones de Red por Nodo",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(mongodb_network_bytesIn_total[5m])",
            "legendFormat": "{{instance}} - Bytes Entrada"
          },
          {
            "expr": "rate(mongodb_network_bytesOut_total[5m])",
            "legendFormat": "{{instance}} - Bytes Salida"
          }
        ],
        "yaxes": [
          {
            "format": "Bps"
          }
        ]
      },
      {
        "id": 7,
        "title": "Uso de Memoria por Nodo",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "mongodb_memory_resident / 1024 / 1024",
            "legendFormat": "{{instance}} - Memoria Resident (MB)"
          },
          {
            "expr": "mongodb_memory_virtual / 1024 / 1024",
            "legendFormat": "{{instance}} - Memoria Virtual (MB)"
          }
        ],
        "yaxes": [
          {
            "format": "mbytes"
          }
        ]
      },
      {
        "id": 8,
        "title": "Colecciones y Documentos por Nodo",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "mongodb_dbstats_collections",
            "format": "table",
            "legendFormat": "Colecciones"
          },
          {
            "expr": "mongodb_dbstats_objects",
            "format": "table",
            "legendFormat": "Documentos"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {
                "Time": 0,
                "Value": 1,
                "instance": 2
              },
              "renameByName": {
                "Value": "Valor",
                "instance": "Nodo"
              }
            }
          }
        ]
      },
      {
        "id": 9,
        "title": "Estado de Replicación",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "mongodb_replset_member_state",
            "format": "table",
            "legendFormat": "Estado"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {
                "Time": 0,
                "Value": 1,
                "instance": 2,
                "state": 3
              },
              "renameByName": {
                "Value": "Estado",
                "instance": "Nodo",
                "state": "Tipo"
              }
            }
          }
        ]
      },
      {
        "id": 10,
        "title": "Oplog Tamaño y Uso",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "mongodb_replset_oplog_size_bytes / 1024 / 1024",
            "legendFormat": "{{instance}} - Tamaño Oplog (MB)"
          },
          {
            "expr": "mongodb_replset_oplog_head_timestamp",
            "legendFormat": "{{instance}} - Timestamp Head"
          }
        ],
        "yaxes": [
          {
            "format": "mbytes"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 2,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
